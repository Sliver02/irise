NEXT_PUBLIC_ENV=local

# EmailJS fallback, used while NEXT_PUBLIC_NEWSLETTER_URL is empty (same values as smup-yoga)
NEXT_PUBLIC_EMAILJS_SERVICE=
NEXT_PUBLIC_EMAILJS_TEMPLATE=
NEXT_PUBLIC_EMAILJS_KEY=
NEXT_PUBLIC_RECEIVER_EMAIL=

# Apps Script web app URL (ends in /exec). Setup: apps-script/newsletter.gs
NEXT_PUBLIC_NEWSLETTER_URL=
